<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1020"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Netzack Videos V2"
            android:textColor="#E8ECF7"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Só cole a chave API — o app identifica a IA e o modelo sozinho"
            android:textColor="#AEB8D4"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="1. Servidor"
            android:textColor="#E8ECF7"
            android:textSize="17sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etServer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Servidor (ex: http://10.0.2.2:8000)"
            android:text="http://10.0.2.2:8000"
            android:textColor="#E8ECF7"
            android:textColorHint="#8794B7"
            android:inputType="textUri" />

        <Button
            android:id="@+id/btnHealth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Testar servidor" />

        <TextView
            android:id="@+id/tvHealth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Toque para verificar se o app alcança o servidor."
            android:textColor="#AEB8D4"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="2. Chave API (só isso!)"
            android:textColor="#E8ECF7"
            android:textSize="17sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Cole aqui: AIza… / sk-… / sk-ant-…"
            android:textColor="#E8ECF7"
            android:textColorHint="#8794B7"
            android:inputType="textPassword" />

        <EditText
            android:id="@+id/etBase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Endpoint próprio (opcional, só p/ IA personalizada)"
            android:textColor="#E8ECF7"
            android:textColorHint="#8794B7"
            android:inputType="textUri" />

        <Button
            android:id="@+id/btnDiscover"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Identificar IA e modelo" />

        <TextView
            android:id="@+id/tvDetected"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="IA detectada: —"
            android:textColor="#AEE7BA"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvDiscover"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="O catálogo oficial aparece aqui. Sua chave nunca é exibida."
            android:textColor="#AEB8D4"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="3. Prompt único"
            android:textColor="#E8ECF7"
            android:textSize="17sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etPrompt"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:gravity="top"
            android:hint="Descreva a cena ou peça o roteiro… um prompt só vale para conversar e para gerar vídeo."
            android:textColor="#E8ECF7"
            android:textColorHint="#8794B7"
            android:inputType="textMultiLine" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Efeito especial (só p/ vídeo)"
            android:textColor="#AEB8D4"
            android:textSize="12sp" />

        <Spinner
            android:id="@+id/spEffect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/spRatio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <Spinner
                android:id="@+id/spResolution"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <Spinner
                android:id="@+id/spDuration"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/cbAudio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Áudio"
                android:textColor="#E8ECF7" />

            <Button
                android:id="@+id/btnChat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Conversar" />

            <Button
                android:id="@+id/btnVideo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Gerar vídeo" />
        </LinearLayout>

        <Button
            android:id="@+id/btnCopy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Copiar resposta" />

        <TextView
            android:id="@+id/tvChat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="A resposta do chat aparece aqui."
            android:textColor="#E8ECF7"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvVideo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="O status do vídeo aparece aqui."
            android:textColor="#AEB8D4"
            android:textSize="12sp" />

        <VideoView
            android:id="@+id/videoView"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnPlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reproduzir vídeo" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Dica: se o vídeo falhar, leia a mensagem de erro — ela diz se é chave sem acesso ao Veo, servidor fora do ar ouprompt inválido. Para produção use HTTPS e auth própria."
            android:textColor="#8794B7"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
