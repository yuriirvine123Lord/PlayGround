# Copie para .env e preencha localmente. Nunca faça commit do .env.
# Na Railway, configure estas vars no painel (Variables) em vez de .env.
# O app também aceita a chave no request (a UI pede só a key e auto-detecta).
GEMINI_API_KEY=
# GOOGLE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_COMPATIBLE_API_KEY=
# Chaves extras do registry inteligente (opcional):
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# TOGETHER_API_KEY=
# HUGGINGFACE_API_KEY=
# OPENROUTER_API_KEY=

MEDIA_DIR=./media
VEO_POLL_INTERVAL_SECONDS=10
VEO_JOB_TIMEOUT_SECONDS=900
CORS_ORIGINS=*
PORT=8080
